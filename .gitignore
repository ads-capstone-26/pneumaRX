# Environment, credentials and build artifacts
.env*
!.env.example
.venv/
__pycache__/
.pytest_cache/
*.egg-info/
/build/
/dist/
.DS_Store
.vscode/
.idea/
.claude/
*coverage*
*.log
*.out
*.pkl
*.db
*.duckdb

# Local datasets, results and archived code
/data/
/data_src/
/runs/
/temp/
/.local_archive/
**/local_results/
/baselines/
/experiments/
/scripts/
/src/pneuma_seeker/
/pneuma-seeker-ui/

# Tests and research tooling stay local
/tests/
/tests_modular/
/test.py
**/test_*.py
**/*_test.py
/apps/evaluate/
/apps/result-validation/repair_policy.py
/apps/**/notebooks/
/apps/**/README.md
/apps/**/DEVELOPMENT.md

# Publish only concise documentation and runtime knowledge
/docs/*
!/docs/evaluation.md
!/docs/interfaces.md
!/docs/mimic3/
/docs/mimic3/*
!/docs/mimic3/mimic3_schema_profile.json
!/docs/mimic3/mimic3_query_conventions.json

# Runnable examples and portable dataset configurations
/examples/*
!/examples/intent_spec.json
!/examples/datasets/
